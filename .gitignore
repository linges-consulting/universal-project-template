# AI workspace: ignore everything, then allow reviewed shared context.
.ai/*
!.ai/shared/
!.ai/shared/**

# Machine-local project data.
local/

# Secrets and local environment overrides. Commit example files instead.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials.json
secrets.*
!secrets.example.*

# Editor and operating-system state.
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs, temporary files, caches, and coverage output.
*.log
*.tmp
*.temp
*.cache
.cache/
tmp/
temp/
coverage/
.coverage
.nyc_output/

# Common generated dependencies and build output.
node_modules/
vendor/
.venv/
venv/
__pycache__/
*.py[cod]
dist/
build/
out/
target/
.gradle/
.terraform/
*.tfstate
*.tfstate.*

# Local databases and dumps.
*.db
*.sqlite
*.sqlite3
*.dump
*.bak

